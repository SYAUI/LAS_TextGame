bool b = true
num n = 123.456
string s = "我是字符串"
//以上三种基础类型是变量声明例，它们分别是布尔、数字与字符串。

//此为混合脚本模式的关卡文件模板，双斜杠注释。
//混合脚本文件后缀为 “.tgl”。
//为规范化，关卡文件存放于Levels文件夹内。

print
{
    <b>当一段文字处于print括号内，引擎将逐行读取</b>
    英文输入模式下特殊符号请使用反斜杠作为转义符
    例如用作文本标签标识的\<和\>，反斜杠本身要当文本输出也需要额外加上一个，像是这样：\\
    
    此外，正文中的空行也会被输出

    使用\<out:变量名\>，即可在文本中输出变量内容，例如：
    字符串变量s所含内容为：<out:s>
}

//请勿在print的{}内编写任何代码，这将会被当作文本直接输出！

print("如果你只是单纯想要输出一句话，请将花括号换成括号")

//如果你想要在一行内编写多条代码，请用英文 ; 隔开它们。
//例如：
n = 1;  n = 1 + n;

choose "这个命令将创建一个可变选项卡"
{
<0> "选项A"
    //你可以直接编写代码，当程序读到<序号>时，会自动视为结束
    print(s)
    //以上会输出字符串s中内容

<1> "选项B"
    //同时你也可以直接使用goto进行跳转（不推荐）,例如：
    goto target
}   

label target:
print
{
    这将直接跳转到上面label定义的代码段后继续执行
}


